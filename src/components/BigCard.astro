---
import { getPlayerStats, getPlayerFirstJoined } from "../data/statsCatalog";
import punishments from "../data/punishments.json";

interface Props {
  name: string;
  uuid: string;
  punishmentDate?: string | Date;
  pastNames?: string[];
}

const { name, uuid, punishmentDate, pastNames } = Astro.props;

const firstJoined = getPlayerFirstJoined(uuid || name);
const stats = getPlayerStats(uuid || name);

const cleanId = uuid ? uuid.replace(/-/g, "").toLowerCase() : "";
const lowerName = name.toLowerCase();
const isJailed = Boolean(
  punishmentDate ||
  punishments.some((p) => {
    const pClean = p.uuid ? p.uuid.replace(/-/g, "").toLowerCase() : "";
    return (cleanId && pClean === cleanId) || (p.name && p.name.toLowerCase() === lowerName);
  })
);
---

<div class="w-full max-w-4xl mx-auto my-6 px-4">
  <div
    class="bg-[#12141c] border border-[#232734] rounded-2xl p-6 sm:p-8 shadow-2xl"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-[#232734]"
    >
      <div class="flex items-center gap-4">
        <div class="relative shrink-0">
          <img
            src={`/avatars/${uuid}.png`}
            onerror={`this.onerror=null;this.src='https://mc-heads.net/avatar/${uuid}/100';`}
            alt={`${name}'s avatar`}
            width="68"
            height="68"
            class="w-16 h-16 sm:w-17 sm:h-17 rounded-xl bg-[#1a1d28] border border-white/10 p-1 [image-rendering:pixelated] shadow-md"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="text-left">
          <h1 class="text-left !text-left w-fit text-2xl sm:text-3xl font-bold text-white tracking-wide m-0" style="text-align: left !important;">{name.trim()}</h1>
          <div class="flex flex-wrap items-center gap-2 mt-1">
            <span class="text-xs text-neutral-400">
              {firstJoined ? `📅 Member since ${firstJoined}` : `📅 Member`}
            </span>
            {
              pastNames && pastNames.length > 0 && (
                <span class="text-[11px] bg-[#1d2130] text-neutral-400 px-2 py-0.5 rounded border border-white/5">
                  aka: {pastNames.join(", ")}
                </span>
              )
            }
          </div>
          {
            isJailed && (
              <div class="flex items-center gap-1.5 mt-1 text-xs text-amber-400 font-medium">
                <span>⚠</span>
                <span>Jailed</span>
              </div>
            )
          }
        </div>
      </div>

      <div>
        <a
          href="/players"
          class="inline-flex items-center gap-2 bg-[#1d2130] hover:bg-[#282d40] border border-white/10 hover:border-white/20 text-neutral-200 hover:text-white px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-150 shadow-sm"
        >
          <svg
            class="w-4 h-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Return to Menu
        </a>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mb-6">
      <strong class="text-neutral-200">{name}</strong> is {
        isJailed ? "a registered player" : "an active player"
      } of the derex smp Minecraft server.{
        firstJoined
          ? ` They have been an explorer of the realm since ${firstJoined}.`
          : ` They are an explorer of the realm.`
      }{
        isJailed && (
          <>
            {" "}Administrative disciplinary action has been recorded for this account pursuant to server community guidelines. See{" "}
            <a href="/notbanlist" class="text-sky-400 hover:underline">disciplinary records</a> for public logs.
          </>
        )
      }
    </p>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr
            class="border-b border-[#232734] text-[11px] font-semibold text-neutral-400 uppercase tracking-wider"
          >
            <th class="py-3 px-3">Stat</th>
            <th class="py-3 px-3 text-right">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#232734]/50 text-xs sm:text-sm">
          {
            stats.map((row) => (
              <tr
                class={`hover:bg-white/[0.02] transition-colors ${row.id === "beds_blown" ? "bg-amber-950/20 hover:bg-amber-950/30 border-t border-amber-500/20" : ""}`}
                data-category={row.category}
                data-stat-name={row.name.toLowerCase()}
              >
                <td class="py-3 px-3">
                  <div class="flex items-center gap-2.5">
                    <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${row.id === "beds_blown" ? "bg-amber-400" : "bg-sky-400"}`} />
                    <span class={`font-medium ${row.id === "beds_blown" ? "text-amber-200 font-semibold" : "text-neutral-200"}`}>{row.name}</span>
                  </div>
                </td>
                <td class="py-3 px-3 text-right text-amber-300 font-bold font-mono text-xs sm:text-sm">
                  {row.total}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
