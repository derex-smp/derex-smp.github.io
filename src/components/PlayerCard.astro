---
interface Props {
  name: string;
  uuid: string;
  punishmentDate?: string | Date;
  pastNames?: string[];
}

const { name, uuid, punishmentDate, pastNames } = Astro.props;
const formattedDate = punishmentDate
  ? new Date(punishmentDate).toLocaleDateString()
  : undefined;
---

<div class="card">
  <img
    src={`/avatars/${uuid}.png`}
    onerror={`this.onerror=null;this.src='https://mc-heads.net/avatar/${uuid}/100';`}
    alt={`${name}'s head`}
    width="100"
    height="100"
    class="w-[100px] h-[100px] mx-auto mb-2.5 block [image-rendering:pixelated]"
    loading="lazy"
  />
  <h2><a href={`/players/${uuid}`}>{name}</a></h2>
  {
    pastNames && pastNames.length > 0 && (
      <p class="text-xs text-gray-600">aka: {pastNames.join(", ")}</p>
    )
  }
  {formattedDate && <p>Date: {formattedDate}</p>}
</div>
