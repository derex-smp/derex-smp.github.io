---
interface Props {
	name: string;
	uuid: string;
	punishmentDate?: string | Date;
}

const { name, uuid, punishmentDate } = Astro.props;
const formattedDate = punishmentDate
	? new Date(punishmentDate).toLocaleDateString()
	: undefined;
---

<div class="card">
	<img
		src={`/avatars/${uuid}.png`}
		onerror={`this.onerror=null;this.src='https://mc-heads.net/avatar/${uuid}/100';`}
		alt={`${name}'s head`}
		loading="lazy"
	/>
	<h2>{name}</h2>
	{formattedDate && <p>Punishment Date: {formattedDate}</p>}
</div>