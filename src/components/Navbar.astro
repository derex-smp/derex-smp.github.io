---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "https://mc.longhorns.dev/map/", label: "World Map", external: true },
  { href: "/players", label: "Players" },
  { href: "https://en.wikipedia.org/wiki/Tetraphobia", label: "四", external: true, title: "四" },
  { href: "/rules", label: "Rules" },
  { href: "/notbanlist", label: "Disciplinary Records" },
];
---

<nav class="sticky top-0 z-50 w-full bg-[#333] border-b border-white/10 font-['PixelCraft'] select-none">
  <div class="max-w-6xl mx-auto px-4 flex items-center justify-between sm:justify-center h-12 relative">
    <a href="/" class="text-white text-sm font-bold tracking-wider sm:hidden">
      derex smp
    </a>

    <div class="hidden sm:flex sm:items-center sm:justify-center sm:gap-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          title={link.title}
          class="text-white hover:bg-[#ddd] hover:text-black px-3.5 py-3 text-sm transition-colors text-center whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-1 sm:absolute sm:right-4 sm:top-1/2 sm:-translate-y-1/2">
      <button
        id="cinema-toggle"
        type="button"
        title="Toggle Wallpaper View (F1)"
        aria-label="Toggle Wallpaper View (F1)"
        class="p-1.5 hover:bg-neutral-700/60 rounded cursor-pointer transition-colors"
      >
        <img src="/images/camera.svg" class="w-5 h-5 block" alt="Camera" />
      </button>

      <details class="sm:hidden group relative">
        <summary class="list-none text-white hover:bg-neutral-700/60 p-1.5 rounded cursor-pointer select-none">
          <svg class="w-5 h-5 block group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="w-5 h-5 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </summary>
        <div class="absolute right-0 top-10 w-48 bg-[#181a20]/95 backdrop-blur-md border border-white/10 rounded-xl p-2 shadow-2xl flex flex-col gap-1 z-50">
          {navLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              title={link.title}
              class="text-neutral-200 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-xs transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</nav>

<style is:global>
  main, header:not(nav), footer, .banlist-container {
    transition: opacity 0.3s ease;
  }
  body.cinema-mode main,
  body.cinema-mode header:not(nav),
  body.cinema-mode footer,
  body.cinema-mode .banlist-container {
    opacity: 0 !important;
    pointer-events: none !important;
  }
  body.cinema-mode nav {
    opacity: 0.25 !important;
    transition: opacity 0.3s ease !important;
  }
  body.cinema-mode nav:hover {
    opacity: 1 !important;
  }
</style>

<script>
  const btn = document.getElementById("cinema-toggle");
  function toggleCinema() {
    document.body.classList.toggle("cinema-mode");
  }
  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleCinema();
  });
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (document.body.classList.contains("cinema-mode") && !target?.closest("#cinema-toggle")) {
      document.body.classList.remove("cinema-mode");
    }
    if (!target?.closest("details")) {
      document.querySelectorAll("details[open]").forEach((d) => d.removeAttribute("open"));
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "F1") {
      e.preventDefault();
      toggleCinema();
    } else if (e.key === "Escape") {
      document.body.classList.remove("cinema-mode");
      document.querySelectorAll("details[open]").forEach((d) => d.removeAttribute("open"));
    }
  });
</script>
