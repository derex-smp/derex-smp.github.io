  <a href="/">Home</a>
  <a
    href="https://mc.longhorns.dev/map/"
    target="_blank"
    rel="noopener noreferrer">World Map</a
  >
  <a href="/players">Players</a>
  <a
    href="https://en.wikipedia.org/wiki/Tetraphobia"
