---
import BaseHead from "../../components/BaseHead.astro";
import Navbar from "../../components/Navbar.astro";
import BigCard from "../../components/BigCard.astro";
import Footer from "../../components/Footer.astro";
import { getAllMembers } from "../../data/players";

export function getStaticPaths() {
  const members = getAllMembers();
  const paths: any[] = [];
  const seen = new Set<string>();

  for (const player of members) {
    // primary canonical page: /player/username (this is what Google indexes)
    const lowerName = player.name.toLowerCase();
    if (!seen.has(lowerName)) {
      seen.add(lowerName);
      paths.push({
        params: { slug: player.name },
        props: { player, isRedirect: false, target: `/player/${player.name}` },
      });
    }

    // old alias redirects: /player/old_name -> bounces to /player/current_name
    // uh prob have to figure something out if another player snatches this name
    if (player.pastNames) {
      for (const past of player.pastNames) {
        if (!/^[a-zA-Z0-9_]{3,16}$/.test(past)) continue;
        const lowerPast = past.toLowerCase();
        if (!seen.has(lowerPast)) {
          seen.add(lowerPast);
          paths.push({
            params: { slug: past },
            props: {
              player,
              isRedirect: true,
              target: `/player/${player.name}`,
            },
          });
        }
      }
    }

    // UUID redirects: /player/011db1cd... -> bounces to /player/current_name
    const lowerUuid = player.uuid.toLowerCase();
    if (!seen.has(lowerUuid)) {
      seen.add(lowerUuid);
      paths.push({
        params: { slug: player.uuid },
        props: { player, isRedirect: true, target: `/player/${player.name}` },
      });
    }
    const cleanUuid = lowerUuid.replace(/-/g, "");
    if (!seen.has(cleanUuid)) {
      seen.add(cleanUuid);
      paths.push({
        params: { slug: cleanUuid },
        props: { player, isRedirect: true, target: `/player/${player.name}` },
      });
    }
  }

  return paths;
}

interface Props {
  player: any;
  isRedirect: boolean;
  target: string;
}

const { player, isRedirect, target } = Astro.props;

const siteUrl = Astro.site?.href || "https://derex-smp.github.io";
const profileUrl = new URL(`/player/${player.name}`, siteUrl).href;
const avatarUrl = new URL(`/avatars/${player.uuid}.png`, siteUrl).href;

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: player.name,
    identifier: player.uuid,
    image: avatarUrl,
    description: `Minecraft player profile and stats for ${player.name} on the derex smp server.`,
    url: profileUrl,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Players",
      item: new URL("/players", siteUrl).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: player.name,
      item: profileUrl,
    },
  ],
};
---

{
  // If the slug visited is an old name or a UUID, trigger a 0s redirect to the active name
  isRedirect ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title>{`Redirecting to ${player.name} - derex smp`}</title>
        <link
          rel="canonical"
          href={
            new URL(target, Astro.site || "https://derex-smp.github.io").href
          }
        />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <meta name="robots" content="noindex, follow" />
      </head>
      <body class="bg-[#0c0d12] text-[#dbdee1] text-center pt-20">
        <p>
          Redirecting to{" "}
          <a class="text-sky-400 hover:underline" href={target}>
            {player.name}
          </a>
          ...
        </p>
      </body>
    </html>
  ) : (
    // Otherwise, this is the real active profile page!
    <html lang="en">
      <head>
        <BaseHead
          title={`${player.name} - derex smp`}
          description={`View ${player.name}'s player profile and history on derex smp.`}
          image={`/avatars/${player.uuid}.png`}
          ogType="profile"
          twitterCard="summary"
          username={player.name}
          structuredData={[profileSchema, breadcrumbSchema]}
        />
      </head>
      <body class="min-h-screen flex flex-col bg-[#0c0d12] text-[#dbdee1]">
        <Navbar />
        <main class="flex-1 flex justify-center items-start py-6 sm:py-10">
          <BigCard
            name={player.name}
            uuid={player.uuid}
            pastNames={player.pastNames ? player.pastNames : []}
          />
        </main>
        <Footer />
      </body>
    </html>
  )
}
