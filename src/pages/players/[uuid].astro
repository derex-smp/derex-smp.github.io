---
import { getAllMembers } from "../../data/players";

// Legacy fallback: redirects old /players/[uuid] bookmarks/Discord links to the new clean /player/[name] route
export function getStaticPaths() {
  const paths: any[] = [];
  const seen = new Set<string>();
  for (const player of getAllMembers()) {
    const u = player.uuid;
    const clean = u.replace(/-/g, '');
    if (!seen.has(u)) {
      seen.add(u);
      paths.push({ params: { uuid: u }, props: { player } });
    }
    if (!seen.has(clean)) {
      seen.add(clean);
      paths.push({ params: { uuid: clean }, props: { player } });
    }
  }
  return paths;
}

const { player } = Astro.props;
const target = `/player/${player.name}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{`Redirecting to ${player.name} - derex smp`}</title>
    <link
      rel="canonical"
      href={new URL(target, Astro.site || "https://derex-smp.github.io").href}
    />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body class="bg-[#0c0d12] text-[#dbdee1] text-center pt-20">
    <p>Redirecting to <a class="text-sky-400 hover:underline" href={target}>{player.name}</a>...</p>
  </body>
</html>
