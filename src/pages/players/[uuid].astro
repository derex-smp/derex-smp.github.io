---
import { getAllMembers } from "../../data/players";

export function getStaticPaths() {
  return getAllMembers().map((player) => ({
    params: { uuid: player.uuid },
    props: { player },
  }));
}

const { player } = Astro.props;
const target = `/player/${player.name}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{`Redirecting to ${player.name} - derex smp`}</title>
    <link
      rel="canonical"
      href={new URL(target, Astro.site || "https://derex-smp.github.io").href}
    />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body class="bg-[#f4f4f4] text-center pt-20">
    <p>Redirecting to <a href={target}>{player.name}</a>...</p>
  </body>
</html>
