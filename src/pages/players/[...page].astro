---
import type { Page } from "astro";
import BaseHead from "../../components/BaseHead.astro";
import Navbar from "../../components/Navbar.astro";
import CardList from "../../components/CardList.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import Footer from "../../components/Footer.astro";
import { getMembers, getAllMembers } from "../../data/players";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const members = getMembers();
  const paginated = paginate(members, { pageSize: 100 });
  const paths: any[] = [...paginated];
  const seen = new Set<string>();

  for (const player of getAllMembers()) {
    const u = player.uuid;
    const clean = u.replace(/-/g, "");
    if (!seen.has(u)) {
      seen.add(u);
      paths.push({
        params: { page: u },
        props: { isRedirect: true, target: `/player/${player.name}`, player },
      });
    }
    if (!seen.has(clean)) {
      seen.add(clean);
      paths.push({
        params: { page: clean },
        props: { isRedirect: true, target: `/player/${player.name}`, player },
      });
    }
  }

  return paths;
}

interface Props {
  page?: Page<any>;
  isRedirect?: boolean;
  target?: string;
  player?: any;
}

const { page, isRedirect, target, player } = Astro.props;
const currentPage = page?.currentPage || 1;
const bgImage = `/images/members_${((currentPage - 1) % 6) + 1}.png`;
---

{
  isRedirect && target ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title>{`Redirecting to ${player?.name || "Player"} - derex smp`}</title>
        <link
          rel="canonical"
          href={
            new URL(target, Astro.site || "https://derex-smp.github.io").href
          }
        />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <meta name="robots" content="noindex, follow" />
      </head>
      <body class="bg-[#0c0d12] text-[#dbdee1] text-center pt-20">
        <p>
          Redirecting to{" "}
          <a class="text-sky-400 hover:underline" href={target}>
            {player?.name || "Player"}
          </a>
          ...
        </p>
      </body>
    </html>
  ) : page ? (
    <html lang="en">
      <head>
        <BaseHead
          title={
            page.currentPage === 1
              ? "Server Players - derex smp"
              : `Server Players (Page ${page.currentPage} of ${page.lastPage}) - derex smp`
          }
          description="Browse the complete roster of active and historical players on the derex smp Minecraft server."
          image={bgImage}
        />
      </head>
      <body
        class="min-h-screen flex flex-col bg-cover bg-fixed bg-no-repeat"
        style={`background-image: url('${bgImage}');`}
      >
        <Navbar />
        <main class="flex-1">
          <CardList
            title="derex smp Players"
            description={`Showing players ${page.start + 1}–${page.end + 1} of ${page.total}`}
            listId="playerlist"
            listClass="memberlist"
          >
            {page.data.map((member: any) => (
              <PlayerCard
                name={member.name}
                uuid={member.uuid}
                pastNames={member.pastNames}
              />
            ))}
          </CardList>
          <nav
            class="flex items-center justify-center gap-1.5 sm:gap-2 my-8 flex-wrap px-4"
            aria-label="Pagination"
          >
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class="px-3 py-1.5 bg-[#c8d6e5] hover:bg-[#b0c4de] text-black border border-[#6b7a8a] rounded text-sm transition-colors cursor-pointer"
              >
                « Prev
              </a>
            ) : (
              <span class="px-3 py-1.5 bg-[#c8d6e5]/40 text-gray-500 border border-[#6b7a8a]/40 rounded text-sm cursor-not-allowed">
                « Prev
              </span>
            )}

            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((p) =>
              p === page.currentPage ? (
                <span class="px-3 py-1.5 bg-[#2c3e50] text-white border border-[#1a252f] rounded text-sm font-bold shadow-inner">
                  {p}
                </span>
              ) : (
                <a
                  href={
                    p === 1
                      ? page.url.first || "/players"
                      : `${(page.url.first || "/players").replace(/\/$/, "")}/${p}`
                  }
                  class="px-3 py-1.5 bg-[#c8d6e5] hover:bg-[#b0c4de] text-black border border-[#6b7a8a] rounded text-sm transition-colors cursor-pointer"
                >
                  {p}
                </a>
              ),
            )}

            {page.url.next ? (
              <a
                href={page.url.next}
                class="px-3 py-1.5 bg-[#c8d6e5] hover:bg-[#b0c4de] text-black border border-[#6b7a8a] rounded text-sm transition-colors cursor-pointer"
              >
                Next »
              </a>
            ) : (
              <span class="px-3 py-1.5 bg-[#c8d6e5]/40 text-gray-500 border border-[#6b7a8a]/40 rounded text-sm cursor-not-allowed">
                Next »
              </span>
            )}
          </nav>
        </main>
        <Footer />
      </body>
    </html>
  ) : null
}
