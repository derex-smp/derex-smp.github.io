---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import SearchBar from "../components/SearchBar.astro";
import Footer from "../components/Footer.astro";
import { getAllMembers } from "../data/players";

const allMembers = getAllMembers();
const groups = allMembers.reduce((acc, p) => {
  const c = (p.name[0] || "#").toUpperCase();
  const k = /^[A-Z]$/.test(c) ? c : "#";
  (acc[k] ||= []).push(p);
  return acc;
}, {} as Record<string, typeof allMembers>);
const letters = ["#", ..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"].filter((l) => groups[l]?.length);

const siteUrl = Astro.site?.href || "https://derex-smp.github.io";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Directory",
      item: new URL("/directory", siteUrl).href,
    },
  ],
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  numberOfItems: allMembers.length,
  itemListElement: allMembers.map((p, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: p.name,
    url: new URL(`/player/${p.name}`, siteUrl).href,
  })),
};
---

<html lang="en">
  <head>
    <link
      rel="preload"
      as="image"
      href="/images/directory.webp"
      fetchpriority="high"
      type="image/webp"
    />
    <BaseHead
      title="Player Directory (A-Z) - derex smp"
      description={`Complete A–Z directory of all ${allMembers.length} active and historical players on the derex smp Minecraft server.`}
      image="/images/directory.webp"
      structuredData={[breadcrumbSchema, itemListSchema]}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#0c0d12] text-[#dbdee1]">
    <div
      class="fixed inset-0 -z-10 pointer-events-none bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/directory.webp');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/75"></div>
    </div>
    <Navbar />
    <main class="flex-1 max-w-4xl mx-auto w-full px-4 py-8">
      <h1 class="text-2xl font-bold text-white! drop-shadow-[2px_2px_0_rgba(0,0,0,1)] mb-6">Player Directory</h1>

      <SearchBar id="directory-search" placeholder="Search 1,000+ players..." class="mb-4" />
      <p id="search-status" class="hidden text-center text-xs text-neutral-300 font-mono mb-4"></p>

      <nav id="alphabet-jump" class="flex flex-wrap justify-center gap-1.5 mb-8" aria-label="Alphabetical jump">
        {letters.map((l) => (
          <a
            href={`#section-${l}`}
            class="px-2.5 py-1 bg-[#1d2130] hover:bg-[#282d40] border border-white/10 rounded text-xs text-neutral-300 font-mono transition-colors"
          >
            {l}
          </a>
        ))}
      </nav>

      <div class="space-y-6">
        {letters.map((l) => (
          <section id={`section-${l}`} class="scroll-mt-16">
            <h2 class="text-base font-bold text-sky-400 border-b border-white/10 pb-1 mb-3 font-mono">
              {l} <span class="text-xs text-neutral-500 font-normal">({groups[l].length})</span>
            </h2>
            <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-1 text-xs sm:text-sm font-mono">
              {groups[l].map((p) => (
                <li>
                  <a href={`/player/${p.name}`} class="text-neutral-300 hover:text-white hover:underline truncate block">
                    {p.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <p class="text-center mt-12 mb-4 text-xs text-stone-200! drop-shadow-[1px_1px_0_rgba(0,0,0,1)] font-mono">
        Prefer visual cards? <a href="/players" class="text-sky-300 hover:text-white hover:underline drop-shadow-[1px_1px_0_rgba(0,0,0,1)]">Browse with player avatars here</a>
      </p>
    </main>
    <Footer />
  </body>
</html>

<script>
  const input = document.getElementById("directory-search") as HTMLInputElement | null;
  const clearBtn = document.querySelector('[data-clear-for="directory-search"]');
  const status = document.getElementById("search-status");
  const sections = document.querySelectorAll("section[id^='section-']");
  const jumpNav = document.getElementById("alphabet-jump");

  function filterDirectory() {
    const query = input?.value.trim().toLowerCase() || "";
    if (clearBtn) {
      clearBtn.classList.toggle("hidden", query.length === 0);
    }
    let totalMatches = 0;

    sections.forEach((sec) => {
      const items = sec.querySelectorAll("li");
      let sectionMatches = 0;
      items.forEach((li) => {
        const name = li.textContent?.trim().toLowerCase() || "";
        const match = query === "" || name.includes(query);
        li.classList.toggle("hidden", !match);
        if (match) sectionMatches++;
      });
      (sec as HTMLElement).classList.toggle("hidden", query.length > 0 && sectionMatches === 0);
      totalMatches += sectionMatches;
    });

    if (jumpNav) {
      jumpNav.classList.toggle("hidden", query.length > 0);
    }

    if (status) {
      if (query.length > 0) {
        status.textContent = `Found ${totalMatches} player${totalMatches === 1 ? "" : "s"} matching "${input?.value.trim()}"`;
        status.classList.remove("hidden");
      } else {
        status.textContent = "";
        status.classList.add("hidden");
      }
    }
  }

  input?.addEventListener("input", filterDirectory);
  clearBtn?.addEventListener("click", () => {
    if (input) {
      input.value = "";
      filterDirectory();
      input.focus();
    }
  });
  input?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      input.value = "";
      filterDirectory();
    }
  });
</script>
