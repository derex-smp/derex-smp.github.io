---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import ServerBanner from "../components/ServerBanner.astro";
import Footer from "../components/Footer.astro";

const siteUrl = Astro.site?.href || "https://derex-smp.github.io";
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "derex smp",
  url: siteUrl,
  description: "Official website of derex smp, an active Minecraft Survival Multiplayer server.",
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "derex smp",
  url: siteUrl,
  sameAs: [
    "https://mc.longhorns.dev/map/",
    "https://www.youtube.com/hashtag/derexsmp",
    "https://www.answeroverflow.com/m/763554707296878633",
  ],
};
---

<html lang="en">
  <head>
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css" />
    <link
      rel="preload"
      as="image"
      href="/images/2025-12-18_03.38.29.webp"
      fetchpriority="high"
      type="image/webp"
    />
    <BaseHead
      title="derex smp - Minecraft Survival Multiplayer Server"
      description="Welcome to derex smp, an active Minecraft Survival Multiplayer server. Explore our community players, world map, and server guidelines."
      structuredData={[websiteSchema, orgSchema]}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#0c0d12]">
    <div
      class="fixed inset-0 -z-10 pointer-events-none bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/2025-12-18_03.38.29.webp');"
    >
    </div>
    <Navbar />
    <header
      class="w3-container w3-center mx-auto w-full px-25 py-32 md:px-10 xl:px-15"
    >
      <h1 class="text-white! drop-shadow-[2px_2px_0_rgba(0,0,0,1)]">
        Welcome to the main page for derex smp
      </h1>
      <p class="text-stone-200! drop-shadow-[1px_1px_0_rgba(0,0,0,1)]">
        Enjoy this little static site we made for fun.<br />
        The navbar above will take you to some cooler links associated with our Minecraft
        Survival Multiplayer world!
      </p>
      <ServerBanner />
    </header>
    <main
      class="w3-display-container w3-animate-opacity w3-text-white min-h-0 flex-1"
    >
      <section class="container flex h-full items-center justify-center">
        <div
          class="map-preview-container flex w-full max-w-150 flex-col items-center justify-center"
        >
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
