---
import Navbar from '../components/Navbar.astro';
import ServerBanner from '../components/ServerBanner.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Welcome to derex smp, our Minecraft Survival Multiplayer server. Find the server rules and the banlist here."
		/>
		<meta property="og:title" content="derex smp - Minecraft Survival Multiplayer Server" />
		<meta
			property="og:description"
			content="Welcome to derex smp, our Minecraft Survival Multiplayer server. Find the server rules and the banlist here."
		/>
		<meta
			property="og:image"
			content="https://raw.githubusercontent.com/DereC4/derecearthmod/master/images/croppedchen.ico"
		/>
		<meta property="og:url" content="https://derex-smp.github.io/" />
		<meta
			name="keywords"
			content="Minecraft, SMP, Survival Multiplayer, derex smp, Minecraft Server, Server Rules, Banlist, Hacked Client, Hacks"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>derex smp</title>
		<link rel="shortcut icon" href="https://raw.githubusercontent.com/DereC4/derecearthmod/master/images/croppedchen.ico" type="image/x-icon" />
		<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.cdnfonts.com/css/pixelcraft-2" rel="stylesheet" />
		<style is:global>
			@import '../styles.css';
		</style>
	</head>
	<body>
		<Navbar />
		<header class="w3-container w3-center mx-auto w-full px-25 py-32 md:px-10 xl:px-15">
			<h1>Welcome to the main page for derex smp</h1>
			<p>
				Enjoy this little static site we made for fun.<br />
				The navbar above will take you to some cooler links associated with our Minecraft Survival Multiplayer world!
			</p>
			<ServerBanner />
		</header>
		<main class="somethingidk w3-display-container w3-animate-opacity w3-text-white min-h-0">
			<section class="container flex h-full items-center justify-center">
				<div class="map-preview-container flex w-full max-w-150 flex-col items-center justify-center"></div>
			</section>
		</main>
	</body>
</html>
