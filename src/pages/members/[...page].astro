---
import { getMembers } from "../../data/players";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const members = getMembers();
  const paginated = paginate(members, { pageSize: 100 });
  return paginated.map((p: any) => {
    const pageNum = p.params.page;
    const target = pageNum ? `/players/${pageNum}` : "/players";
    return {
      params: { page: pageNum },
      props: { target },
    };
  });
}

interface Props {
  target: string;
}

const { target } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Players - derex smp</title>
    <link
      rel="canonical"
      href={new URL(target, Astro.site || "https://derex-smp.github.io").href}
    />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body class="bg-[#0c0d12] text-[#dbdee1] text-center pt-20">
    <p>
      Redirecting to <a class="text-sky-400 hover:underline" href={target}>{target}</a>...
    </p>
  </body>
</html>
