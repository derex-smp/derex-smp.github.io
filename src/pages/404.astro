---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <link
      rel="preload"
      as="image"
      href="/images/2021-12-25_23.21.02.webp"
      fetchpriority="high"
      type="image/webp"
    />
    <BaseHead
      title="404 - Page Not Found | derex smp"
      description="The requested page could not be found."
      noindex={true}
    />
  </head>
  <body
    class="min-h-screen flex flex-col bg-[#0c0d12] text-center text-white font-['PixelCraft']"
  >
    <div
      class="fixed inset-0 -z-10 pointer-events-none bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/2021-12-25_23.21.02.webp');"
    >
    </div>
    <Navbar />
    <main class="flex-1 mt-40 px-4 font-['PixelCraft']">
      <h1
        class="text-4xl md:text-5xl font-bold mb-6 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
      >
        404 - Page Not Found
      </h1>
      <p
        class="text-lg md:text-xl mb-6 text-gray-200 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
      >
        The coordinates you entered lead to nowhere.
      </p>
      <p>
        <a
          href="/"
          class="inline-block bg-[#333] hover:bg-[#555] text-white border-2 border-white px-6 pt-[5px] pb-[15px] text-base transition-colors duration-150"
        >
          Return to Home
        </a>
      </p>
    </main>
    <Footer />
  </body>
</html>
