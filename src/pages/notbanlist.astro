---
import Navbar from '../components/Navbar.astro';
import CardList from '../components/CardList.astro';
import PlayerCard from '../components/PlayerCard.astro';
import punishments from '../data/punishments.json';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Disciplinary Records - derex smp</title>
		<meta
			property="og:image"
			content="https://raw.githubusercontent.com/DereC4/derecearthmod/master/images/croppedchen.ico"
		/>
		<meta
			name="description"
			content="derex smp Disciplinary Records - Official administrative log of player sanctions, rule enforcement actions, and jailing records on our Minecraft server."
		/>
		<meta name="robots" content="index, follow" />
		<meta
			name="keywords"
			content="Minecraft, derex smp, Disciplinary Records, Banlist, Sanctions, Server Rules, Moderation Log, Jails"
		/>
		<meta name="author" content="derex smp" />
		<link rel="shortcut icon" href="https://raw.githubusercontent.com/DereC4/derecearthmod/master/images/croppedchen.ico" type="image/x-icon" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.cdnfonts.com/css/pixelcraft-2" rel="stylesheet" />
		<style is:global>
			@import '../styles.css';
		</style>
	</head>
	<body
		class="min-h-screen bg-cover bg-fixed bg-no-repeat"
		style="background-image: url('/images/2021-12-25_23.21.02.png');"
	>
		<Navbar />
		<CardList
			title="derex smp Disciplinary Records"
			description="Public log of server rule enforcement actions and jailing records"
			listId="banlist"
			listClass="banlist"
		>
			{punishments.map((punishment) => (
				<PlayerCard
					name={punishment.name}
					uuid={punishment.uuid}
					punishmentDate={new Date(punishment.punishmentDate)}
				/>
			))}
		</CardList>
		<div style="text-align: center; margin: 30px 0; color: #ccc; font-size: 0.9rem;">
			<p>To dispute a record, submit a correction, or request an appeal, please open a ticket on our official Discord server.</p>
		</div>
	</body>
</html>