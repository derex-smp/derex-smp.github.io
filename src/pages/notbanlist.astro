---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import CardList from '../components/CardList.astro';
import PlayerCard from '../components/PlayerCard.astro';
import punishments from '../data/punishments.json';
---

<html lang="en">
	<head>
		<BaseHead
			title="Disciplinary Records - derex smp"
			description="Official administrative log of server rule enforcement actions and jailing records on derex smp."
		/>
	</head>
	<body
		class="min-h-screen bg-cover bg-fixed bg-no-repeat"
		style="background-image: url('/images/2021-12-25_23.21.02.png');"
	>
		<Navbar />
		<CardList
			title="derex smp Disciplinary Records"
			description="Public log of server rule enforcement actions and jailing records"
			listId="banlist"
			listClass="banlist"
		>
			{punishments.map((punishment) => (
				<PlayerCard
					name={punishment.name}
					uuid={punishment.uuid}
					punishmentDate={new Date(punishment.punishmentDate)}
				/>
			))}
		</CardList>
		<div style="text-align: center; margin: 30px 0; color: #ccc; font-size: 0.9rem;">
			<p>To dispute a record, submit a correction, or request an appeal, please open a ticket on our official Discord server.</p>
		</div>
	</body>
</html>